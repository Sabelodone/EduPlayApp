                    'study_stats': 'GET /api/study-stats',
                    'recent_activity': 'GET /api/recent-activity',
                    'home': 'GET /api/home'
                },
                'general': {
                    'health': 'GET /api/health',
                    'test': 'GET /api/test'
                }
            }
        })

    # ========== CATCH-ALL FOR UNDEFINED ENDPOINTS ==========
    @app.route('/api/<path:path>')
    def catch_all(path):
        """Catch-all route for undefined API endpoints"""
        return jsonify({
            "error": f"Endpoint /api/{path} not found",
            "available_endpoints": [
                "/api/auth/signup",
                "/api/auth/signin", 
                "/api/auth/me",
                "/api/auth/profile",
                "/api/auth/forgot-password",
                "/api/auth/logout",
                "/api/dashboard/stats",
                "/api/dashboard/recent-activity", 
                "/api/dashboard/upcoming-challenges",
                "/api/dashboard/achievements",
                "/api/profile/avatar",
                "/api/profile/preferences",
                "/api/achievements",
                "/api/study-stats",
                "/api/recent-activity",
                "/api/lessons",
                "/api/games", 
                "/api/quizzes",
                "/api/ai/generate-content",
                "/api/ai/analyze-solution",
                "/api/ai/generate-hint",
                "/api/home",
                "/api/health"
            ]
        }), 404

    # Create database tables and sample data
